# Copy to .env.local and fill in (never commit real values).

# --- CMS / lead capture (Supabase) ---
# Project settings → API in your Supabase dashboard.
SUPABASE_URL=https://uvoypzpuweyubqxqviqa.supabase.co
# Settings → API → "service_role" secret key (NOT the anon/publishable key).
# Server-only — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin auth ---
# Any random string, 32+ characters (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=

# --- Chatbot (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Contact form delivery (optional) ---
RESEND_API_KEY=
CONTACT_FROM="BrandZaha Website <no-reply@brandzaha.com>"
CONTACT_TO=Brandzaha@gmail.com
