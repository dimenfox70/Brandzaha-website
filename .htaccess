# =============================================================
# BrandZaha v2 — Apache configuration
# Clean URLs · 301 redirects · security headers · caching
# =============================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # RewriteBase /

  # ---- Force HTTPS + non-www -> www (adjust if hosting differs) ----
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301,NE]

  # ---- 301 redirects (v1 -> v2, per SOW §4.3) ----
  RewriteRule ^clients/?$                       /about/ [R=301,L]
  RewriteRule ^team/?$                          /about/ [R=301,L]
  RewriteRule ^about-us/?$                      /about/ [R=301,L]
  RewriteRule ^contact-us/?$                    /contact/ [R=301,L]
  RewriteRule ^case-studies/?$                  /work/ [R=301,L]
  RewriteRule ^case-study-zenith-home/?$        /work/zenith-home/ [R=301,L]
  RewriteRule ^case-study-fpf-foundation/?$     /work/fpf-foundation/ [R=301,L]
  RewriteRule ^case-study-property-bapu/?$      /work/property-bapu/ [R=301,L]
  RewriteRule ^erp-software-jaipur/?$           /software-development-jaipur/ [R=301,L]
  RewriteRule ^crm-software-jaipur/?$           /software-development-jaipur/ [R=301,L]
  RewriteRule ^hrm-software-jaipur/?$           /software-development-jaipur/ [R=301,L]

  # ---- Strip .php extension: redirect old -> clean, with trailing slash ----
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.php[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L,NE]

  # ---- Dynamic sitemap ----
  RewriteRule ^sitemap\.xml$              sitemap.php         [L]

  # ---- Core clean-URL routes ----
  RewriteRule ^work/?$                    work.php            [L,QSA]
  RewriteRule ^work/([a-z0-9\-]+)/?$      project.php?slug=$1 [L,QSA]
  RewriteRule ^services/?$                services.php        [L,QSA]
  RewriteRule ^about/?$                   about.php           [L,QSA]
  RewriteRule ^blog/?$                    blog.php            [L,QSA]
  RewriteRule ^contact/?$                 contact.php         [L,QSA]

  # ---- SEO landing pages (kept URLs) -> single template ----
  RewriteRule ^(web-development-jaipur|digital-marketing-jaipur|graphic-designing-jaipur|mobile-app-development-jaipur|influencer-marketing-jaipur|content-strategy-jaipur|cyber-security-jaipur|software-development-jaipur|it-training-jaipur)/?$ service-landing.php?service=$1 [L,QSA]

  # ---- Fallback: map /page/ to page.php if it exists ----
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^([a-z0-9\-]+)/?$ $1.php [L,QSA]
</IfModule>

# ---- Custom error document ----
ErrorDocument 404 /404.php

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # Allow the fonts/CDN/maps we actually use
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.google.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; object-src 'none'; base-uri 'self'"
  Header unset X-Powered-By
</IfModule>

# ---- Compression ----
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|avif|svg|jpg|jpeg|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---- Protect sensitive files ----
<FilesMatch "^(composer\.(json|lock)|\.git.*|README\.md|.*\.md)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^(data|partials)/ - [F,L]
</IfModule>
